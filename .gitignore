# Dependency stores and build output, at any workspace depth.
node_modules/
.pnpm-store/
target/
dist/
coverage/
*.log
test-results/
playwright-report/
/apps/desktop/src-tauri/gen/schemas/

# Local configuration and credentials. Only sanitized examples belong in Git.
.env
.env.*
!.env.example
!.env.*.example
.npmrc
.netrc
*.pem
*.key
*.p12
*.pfx
credentials.json
secrets.json
pairing.json

# Local user data and source backup payloads (not implementation directories).
/workspaces/
/local-data/
/backups/
/artifacts/
/exports/
/backup-staging/
*.upload
*.tar
*.partial
*.db
*.db-*
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*
*.bundle
*.patch

# OS/editor-local state.
.DS_Store
Thumbs.db
.vs/
*.user
